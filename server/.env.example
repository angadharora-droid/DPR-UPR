# Copy to .env and adjust
PORT=5001
MONGODB_URI=mongodb://localhost:27017/dpr_upr
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=12h

# SMTP for sending UPR to Purchase Head.
# Leave SMTP_HOST empty to run in dev mode (emails are logged, not sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CPH Requisitions <no-reply@cph.local>"

# Fallback Purchase Head email if no active purchase_head user exists
PURCHASE_HEAD_EMAIL=purchase@cph.local

# Central sign-on (optional). Leave AUTH_SERVICE_URL empty to disable SSO.
AUTH_SERVICE_URL=
SSO_APP_KEY=procurement-model
# Must match SSO_SHARED_SECRET in the auth service; protects GET /api/sso/users
SSO_SHARED_SECRET=
